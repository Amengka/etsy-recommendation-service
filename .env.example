# Copy to .env and adjust. Defaults match a local Redis started with:
#   docker compose up   (or: docker run -d -p 6379:6379 redis)
REDIS_HOST=localhost
REDIS_PORT=6379
# Local Redis has no auth by default; leave empty.
REDIS_PASSWORD=

# Recommender tuning
NUM_CLUSTERS=49
NUM_LISTINGS_EACH=3
EPSILON=0.3
